        {
          "name": "SETUP - Admin Login",
          "event": [{
            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const suffix = `${Date.now()}_${Math.random().toString(16).slice(2,8)}`;",
                "pm.collectionVariables.set('st_name', `auto_api_service_type_${suffix}`);",
                "pm.collectionVariables.set('st_updated_name', `auto_api_service_type_updated_${suffix}`);",
                "pm.collectionVariables.unset('service_type_id');",
                "pm.collectionVariables.unset('service_type_boundary_id');",
                "pm.collectionVariables.unset('st_access_token');",
                "pm.collectionVariables.unset('st_viewer_token');"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Accept", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{admin_email}}\",\"password\":\"{{admin_password}}\"}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{base_url}}/api/admin/auth/login", "host": ["{{base_url}}"], "path": ["api","admin","auth","login"] }
