                "exec": [
                  "if (!pm.collectionVariables.get('expired_access_token')) {",
                  "  console.log('SKIP TC_005: chưa có expired_access_token');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{expired_access_token}}", "type": "string" }] },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/admin/auth/me", "host": ["{{base_url}}"], "path": ["api","admin","auth","me"] }
          },
          "response": []
        }
      ]
    },
