{
  "info": {
    "_postman_id": "90c01ff5-61a1-4bdb-90c8-c3b45efde661",
    "name": "Welvie - Admin Profile API",
    "description": "Collection chạy 27 test case cho GET/POST /api/admin/auth/me, gồm positive, validation, authentication, data integrity, security và abnormal.\n\nCách chạy:\n1. Import collection này và testcase/welvie-stg.postman_environment.json.\n2. Chọn environment Welvie STG; bảo đảm admin_email/admin_password có giá trị hợp lệ.\n3. Run toàn bộ collection đúng thứ tự. Setup tự login, lưu data.access_token vào Collection Variable access_token và snapshot profile; Teardown tự khôi phục name ban đầu.\n4. Muốn chạy TC_005 và TC_015, điền Collection Variable expired_access_token bằng token admin đã hết hạn. Nếu để trống, hai request tự skip.\n\nNguồn expected: basic design/document.json (OpenAPI 3.1.0). Các nhánh chưa đủ contract như 403, mass assignment, malformed JSON, sai Content-Type, payload quá lớn và rate limit không được đưa vào collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const requestName = pm.info.requestName;",
          "const tc = (requestName.match(/TC_\\d{3}/) || [null])[0];",
          "const status200 = new Set(['TC_001','TC_002','TC_006','TC_007','TC_008','TC_016','TC_017','TC_018']);",
          "const status401 = new Set(['TC_003','TC_004','TC_005','TC_013','TC_014','TC_015','TC_019','TC_020','TC_021','TC_022']);",
          "const status422 = new Set(['TC_009','TC_010','TC_011','TC_012','TC_023','TC_024','TC_025','TC_026','TC_027']);",
          "const isSetup = requestName.startsWith('SETUP');",
          "const isTeardown = requestName.startsWith('TEARDOWN');",
          "const isSnapshot = requestName.startsWith('SNAPSHOT');",
          "const expectedStatus = isSetup || isSnapshot || isTeardown || status200.has(tc) ? 200 : status401.has(tc) ? 401 : status422.has(tc) ? 422 : null;",
          "if (expectedStatus !== null) {",
          "  pm.test(`HTTP ${expectedStatus}`, () => pm.response.to.have.status(expectedStatus));",
          "}",
          "pm.test('Content-Type là application/json', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));",
          "let j;",
          "pm.test('Response là JSON hợp lệ', () => { j = pm.response.json(); pm.expect(j).to.be.an('object'); });",
          "if (!j) { throw new Error('Response không phải JSON'); }",
          "pm.test('Envelope có đủ message, errors, data, meta', () => pm.expect(j).to.include.all.keys('message','errors','data','meta'));",
          "if (expectedStatus === 200) {",
          "  pm.test('Success envelope đúng kiểu', () => {",
          "    pm.expect(j.message).to.be.a('string');",
          "    pm.expect(j.errors).to.be.null;",
          "    pm.expect(j.data).to.be.an('object');",
          "    pm.expect(j.meta).to.be.an('object');",
          "  });",
          "}",
          "if (expectedStatus === 401) {",
          "  pm.test('AuthenticationException đúng contract', () => {",
          "    pm.expect(j.message).to.be.a('string');",
          "    pm.expect(j.errors).to.be.null;",
          "    pm.expect(j.data).to.be.null;",
          "    pm.expect(j.meta).to.be.an('object');",
          "  });",
          "}",
          "if (expectedStatus === 422) {",
          "  pm.test('ValidationException đúng contract', () => {",
          "    pm.expect(j.message).to.be.a('string');",
          "    pm.expect(j.errors).to.be.an('object');",
          "    pm.expect(j.errors).to.have.property('name').that.is.an('array');",
          "    pm.expect(j.data).to.be.null;",
          "    pm.expect(j.meta).to.be.an('object');",
          "  });",
          "}",
          "const isProfileSuccess = expectedStatus === 200 && !isSetup;",
          "if (isProfileSuccess) {",
          "  pm.test('ProfileResource đúng contract', () => {",
          "    const d = j.data;",
          "    pm.expect(d).to.include.all.keys('id','name','email','role','status','created_at');",
          "    pm.expect(Number.isInteger(d.id), 'id integer').to.be.true;",
          "    pm.expect(d.name).to.be.a('string');",
          "    pm.expect(d.email).to.be.a('string');",
          "    pm.expect(Number.isInteger(d.role), 'role integer').to.be.true;",
          "    pm.expect(Number.isInteger(d.status), 'status integer').to.be.true;",
          "    pm.expect(d.created_at === null || (typeof d.created_at === 'string' && !Number.isNaN(Date.parse(d.created_at))), 'created_at date-time hoặc null').to.be.true;",
          "  });",
          "}",
          "if (isSetup && pm.response.code === 200 && j.data && j.data.access_token) {",
          "  pm.test('Login trả access_token', () => pm.expect(j.data.access_token).to.be.a('string').and.not.empty);",
          "  pm.collectionVariables.set('access_token', j.data.access_token);",
          "  pm.environment.set('access_token', j.data.access_token);",
          "}",
          "if (isSnapshot && pm.response.code === 200) {",
          "  pm.collectionVariables.set('original_name', j.data.name);",
          "  pm.collectionVariables.set('original_id', String(j.data.id));",
          "  pm.collectionVariables.set('original_email', j.data.email);",
          "  pm.collectionVariables.set('original_role', String(j.data.role));",
          "  pm.collectionVariables.set('original_status', String(j.data.status));",
          "  pm.collectionVariables.set('original_created_at', j.data.created_at === null ? '__NULL__' : j.data.created_at);",
          "}",
          "if (tc === 'TC_001' && pm.response.code === 200) {",
          "  pm.test('Trả đúng admin đã snapshot', () => {",
          "    pm.expect(String(j.data.id)).to.equal(pm.collectionVariables.get('original_id'));",
          "    pm.expect(j.data.email).to.equal(pm.collectionVariables.get('original_email'));",
          "  });",
          "}",
          "if (['TC_006','TC_007','TC_008','TC_016','TC_018'].includes(tc) && pm.response.code === 200) {",
          "  const expectedName = pm.variables.replaceIn(pm.request.body.raw);",
          "  const bodyName = JSON.parse(expectedName).name;",
          "  pm.test('Response trả đúng name đã gửi', () => pm.expect(j.data.name).to.equal(bodyName));",
          "}",
          "if (tc === 'TC_008' && pm.response.code === 200) {",
          "  pm.test('Name giữ đủ 255 ký tự, không bị truncate', () => pm.expect(j.data.name).to.have.lengthOf(255));",
          "}",
          "if (tc === 'TC_016' && pm.response.code === 200) {",
          "  pm.sendRequest({",
          "    url: pm.collectionVariables.get('base_url_runtime') + '/api/admin/auth/me',",
          "    method: 'GET',",
          "    header: { Accept: 'application/json', Authorization: 'Bearer ' + pm.collectionVariables.get('access_token') }",
          "  }, (err, res) => {",
          "    pm.test('GET xác nhận sau update không lỗi transport', () => pm.expect(err).to.equal(null));",
          "    pm.test('GET xác nhận sau update trả 200', () => pm.expect(res.code).to.equal(200));",
          "    const after = res.json().data;",
          "    pm.test('Name được lưu và các field khác không đổi', () => {",
          "      pm.expect(after.name).to.equal('Admin Persistence 01');",
          "      pm.expect(String(after.id)).to.equal(pm.collectionVariables.get('original_id'));",
          "      pm.expect(after.email).to.equal(pm.collectionVariables.get('original_email'));",
          "      pm.expect(String(after.role)).to.equal(pm.collectionVariables.get('original_role'));",
          "      pm.expect(String(after.status)).to.equal(pm.collectionVariables.get('original_status'));",
          "      const originalCreatedAt = pm.collectionVariables.get('original_created_at');",
          "      pm.expect(after.created_at === null ? '__NULL__' : after.created_at).to.equal(originalCreatedAt);",
          "    });",
          "  });",
          "}",
          "if (['TC_017','TC_018'].includes(tc) && pm.response.code === 200) {",
          "  const banned = new Set(['password','password_hash','access_token','refresh_token','secret','secretkey']);",
          "  const found = [];",
          "  const walk = value => {",
          "    if (!value || typeof value !== 'object') return;",
          "    Object.keys(value).forEach(key => { if (banned.has(key.toLowerCase())) found.push(key); walk(value[key]); });",
          "  };",
          "  walk(j);",
          "  pm.test('Response không chứa key nhạy cảm', () => pm.expect(found, `Key nhạy cảm: ${found.join(', ')}`).to.be.empty);",
          "}",
          "if (isTeardown && pm.response.code === 200) {",
          "  pm.test('Đã khôi phục name ban đầu', () => pm.expect(j.data.name).to.equal(pm.collectionVariables.get('original_name')));",
          "  pm.collectionVariables.unset('access_token');",
          "  pm.environment.unset('access_token');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Setup",
      "item": [
        {
          "name": "SETUP - Login và lưu access_token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('access_token');",
                  "pm.collectionVariables.unset('original_name');",
                  "pm.collectionVariables.set('base_url_runtime', pm.variables.replaceIn('{{base_url}}'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "login"]
            },
            "description": "Dependency: login, lấy data.access_token và lưu vào Collection Variable access_token."
          },
          "response": []
        },
        {
          "name": "SNAPSHOT - Lưu profile ban đầu",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/admin/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "me"]
            },
            "description": "Lưu name và các field profile ban đầu để kiểm data integrity và teardown."
          },
          "response": []
        }
      ]
    },
    {
